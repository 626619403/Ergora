    "temporal": {
      "kind": "support",
      "implementation": "temporal",
      "layers": [
        "scheduler"
      ],
      "capabilities": [],
      "operations": {
        "scheduler": [
          "research.schedule",
          "research.worker"
        ]
      },
      "platforms": [],
      "probe": "python-module",
      "configuration": {
        "type": "object",
        "properties": {
          "tool": {
            "const": "temporal"
          },
          "address": {
            "type": "string",
            "title": "Temporal 地址",
            "default": "127.0.0.1:7233",
            "minLength": 1,
            "pattern": "\\S"
          },
          "namespace": {
            "type": "string",
            "title": "命名空间",
            "default": "default",
            "minLength": 1,
            "pattern": "\\S"
          },
          "task_queue": {
            "type": "string",
            "title": "项目 Task Queue",
            "minLength": 1,
            "x-ergora-project-default": "ergora-{project_id}-research",
            "pattern": "\\S"
          }
        },
        "required": [
          "tool",
          "address",
          "namespace",
          "task_queue"
        ],
        "additionalProperties": false
      },
      "note": "Schedule 和 worker 使用 CLI 创建和启动。各项目使用独立 task queue；新 Schedule 默认暂停。",
      "installation": {
        "kind": "extra",
        "extra": "temporal"
      },
      "module": "temporalio"
    },
    "forgekernel": {
      "kind": "support",
      "implementation": "forgekernel",
      "layers": [
        "kernel"
      ],
      "capabilities": [],
      "operations": {
        "kernel": [
          "kernel.plan",
          "kernel.prepare",
          "kernel.run",
          "kernel.status"
        ]
      },
      "platforms": [
        "linux"
      ],
      "probe": "campaign",
      "configuration": {
        "type": "object",
        "properties": {
          "tool": {
            "const": "forgekernel"
          },
          "checkout": {
            "type": "string",
            "title": "固定版本源码目录",
            "minLength": 1,
            "pattern": "\\S",
            "not": {
              "pattern": "\u0000"
            }
          },
          "python": {
            "type": "string",
            "title": "Forge 环境 Python 绝对路径",
            "minLength": 1,
            "pattern": "\\S",
            "not": {
              "pattern": "\u0000"
            }
          },
          "task": {
            "type": "string",
            "title": "原生任务目录绝对路径",
            "minLength": 1,
            "pattern": "\\S",
            "not": {
              "pattern": "\u0000"
            }
          }
        },
        "required": [
          "tool",
          "checkout",
          "python",
          "task"
        ],
        "additionalProperties": false
      },
      "note": "使用独立安装器准备固定版本。当前适配仅支持 local delivery，执行需要 Claude 与 GPU；计划检查不运行它们。",
      "installation": {
        "kind": "git",
        "repository": "https://github.com/OpenBMB/ForgeKernel.git",
        "commit": "5030503d3ff71851aa34c14b9caf13ebfa9d9a78"
      },
      "platform_note": "Requires Linux; use WSL2"
    },
    "github": {
      "kind": "issue-tracker",
      "implementation": "github",
      "layers": [
        "tracker"
      ],
      "capabilities": [],
      "operations": {
        "tracker": [
          "issue.show",
          "issue.writeback.prepare",
          "issue.writeback.label-prepare",
          "issue.writeback.status",
          "issue.writeback.send",
          "issue.writeback.observe",
          "issue.candidate.observe",
          "issue.review.link",
          "issue.review.show"
        ]
      },
      "platforms": [],
      "probe": "remote",
      "configuration": {
        "type": "object",
        "properties": {
          "tool": {
            "const": "github"
          },
          "project": {
            "title": "仓库命名空间（owner/name）",
            "type": "string",
            "maxLength": 300,
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
            "not": {
              "pattern": "\\s"
            },
            "description": "Repository owner/name"
          },
          "api_url": {
            "title": "API 基地址",
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s]+$",
            "not": {
              "pattern": "\\s"
            },
            "default": "https://api.github.com",
            "description": "HTTPS API base; HTTP is supported only on loopback"
          },
          "token_env": {
            "title": "凭据环境变量名（可选）",
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": {
              "pattern": "\\s"
            },
            "description": "Optional environment variable name; omit for anonymous public reads"
          },
          "api_version": {
            "title": "GitHub API 版本",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "not": {
              "pattern": "\\s"
            },
            "default": "2022-11-28"
          }
        },
        "required": [
          "tool",
          "project"
        ],
        "additionalProperties": false
      },
      "note": "GitHub/GitLab 工单上下文与显式候选评论；只保存凭据变量名。写入需已导出v7候选及精确意图确认；unknown不重发。读取不授予执行权限；更新时间/ETag不是写入CAS。",
      "installation": null
    },
    "gitlab": {
      "kind": "issue-tracker",
      "implementation": "gitlab",
      "layers": [
        "tracker"
      ],
      "capabilities": [],
      "operations": {
        "tracker": [
          "issue.show",
          "issue.writeback.prepare",
          "issue.writeback.status",
          "issue.writeback.send",
          "issue.writeback.observe",
          "issue.candidate.observe",
          "issue.review.link",
          "issue.review.show"
        ]
      },
      "platforms": [],
      "probe": "remote",
      "configuration": {
        "type": "object",
        "properties": {
          "tool": {
            "const": "gitlab"
          },
          "project": {
            "title": "项目命名空间（含子组）",
            "type": "string",
            "maxLength": 300,
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$",
            "not": {
              "pattern": "\\s"
            },
            "description": "Project namespace/path, including subgroups"
          },
          "api_url": {
            "title": "API 基地址",
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s]+$",
            "not": {
              "pattern": "\\s"
            },
            "default": "https://gitlab.com/api/v4",
            "description": "HTTPS API base; HTTP is supported only on loopback"
          },
          "token_env": {
            "title": "凭据环境变量名（可选）",
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": {
              "pattern": "\\s"
            },
            "description": "Optional environment variable name; omit for anonymous public reads"
          }
        },
        "required": [
          "tool",
          "project"
        ],
        "additionalProperties": false
      },
      "note": "GitHub/GitLab 工单上下文与显式候选评论；只保存凭据变量名。写入需已导出v7候选及精确意图确认；unknown不重发。读取不授予执行权限；更新时间/ETag不是写入CAS。",
      "installation": null
    }
  },
  "installation_profiles": {
    "scope": "sdk-installation-recipes",
    "default": "control",
