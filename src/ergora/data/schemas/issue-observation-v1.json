{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "issue", "response", "context_only"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "project": {
      "type": "object", "additionalProperties": false, "required": ["id", "revision"],
      "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}}
    },
    "configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_at": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "api_url", "project", "issue_id"],
      "properties": {
        "provider": {"enum": ["github", "gitlab"]},
        "api_url": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "issue_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"}
      }
    },
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["native_id", "title", "body", "state", "labels", "web_url", "updated_at"],
      "properties": {
        "native_id": {"type": "integer", "minimum": 1},
        "title": {"type": "string"},
        "body": {"type": "string"},
        "state": {"enum": ["open", "opened", "closed"]},
        "labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "web_url": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "minLength": 1}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "etag"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "etag": {"type": ["string", "null"]}
      }
    },
    "context_only": {"const": true, "type": "boolean"}
  }
}
