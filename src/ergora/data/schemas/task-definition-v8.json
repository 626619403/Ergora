{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "issue_id",
    "input",
    "composition",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 8
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "task_type": {
      "enum": [
        "repository-governance",
        "large-change"
      ]
    },
    "issue_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "starting_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "input": {
      "type": "object"
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "manifest_digest",
        "review_instance",
        "mode",
        "execution",
        "review_protocol",
        "preparation",
        "native"
      ],
      "properties": {
        "review_protocol": {
          "const": "dag-v1"
        },
        "manifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "mode": {
          "enum": [
            "text-only",
            "task-mcp"
          ]
        },
        "backend_overrides": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding",
              "reason"
            ],
            "properties": {
              "binding": {
                "type": "object"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              }
            }
          }
        },
        "diversity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "enum": [
                "prefer-distinct",
                "require-distinct",
                "allow-same"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "instance",
            "assignments",
            "mode"
          ],
          "properties": {
            "protocol": {
              "const": "work-units-v2"
            },
            "instance": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "assignments": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 128,
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "mode": {
              "const": "workspace-task-mcp"
            }
          }
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "inventory",
            "plan",
            "mode",
            "repository_paths"
          ],
          "properties": {
            "protocol": {
              "const": "preparation-dag-v1"
            },
            "inventory": {
              "$ref": "#/$defs/preparation_stage"
            },
            "plan": {
              "$ref": "#/$defs/preparation_stage"
            },
            "mode": {
              "enum": [
                "text-only",
                "task-mcp"
              ]
            },
            "repository_paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "instance"
          ],
          "properties": {
            "protocol": {
              "const": "six-stage-v1"
            },
            "instance": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_sha256"
      ],
      "properties": {
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "not": {
            "pattern": "\\s"
          }
        }
      }
    },
    "amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "project_revision", "change", "definition_sha256", "predecessor"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "project_revision": {"type": "integer", "minimum": 1},
        "change": {"type": "string", "maxLength": 4000, "pattern": "\\S"},
        "definition_sha256": {"$ref": "#/$defs/sha256"},
        "predecessor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_id", "workflow_id", "run_id", "creation_sha256", "submission_sha256", "request_sha256",
                       "admission_sha256", "budget_sha256", "history_jobs_sha256", "evidence_sha256",
                       "release_evidence_sha256", "plan_receipt_sha256"],
          "properties": {
            "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
            "workflow_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "creation_sha256": {"$ref": "#/$defs/sha256"},
            "submission_sha256": {"$ref": "#/$defs/sha256"},
            "request_sha256": {"$ref": "#/$defs/sha256"},
            "admission_sha256": {"$ref": "#/$defs/sha256"},
            "budget_sha256": {"$ref": "#/$defs/sha256"},
            "history_jobs_sha256": {"$ref": "#/$defs/sha256"},
            "evidence_sha256": {"$ref": "#/$defs/sha256"},
            "release_evidence_sha256": {"$ref": "#/$defs/sha256"},
            "plan_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "cleanup_seconds",
        "model_invocations"
      ],
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 604800
        },
        "cleanup_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604799
        },
        "model_invocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 258
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_version",
        "memories",
        "skills"
      ],
      "properties": {
        "root_version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "shared_case": {
          "type": "object",
          "additionalProperties": false,
          "required": ["library", "id", "revision", "sha256", "instance", "require_current"],
          "properties": {
            "library": {"type": "string", "minLength": 1, "maxLength": 4096},
            "id": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "revision": {"type": "integer", "minimum": 1, "maximum": 999999999},
            "sha256": {"$ref": "#/$defs/sha256"},
            "instance": {"type": "string", "minLength": 1, "maxLength": 2048},
            "require_current": {"type": "boolean"}
          }
        },
        "memories": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "digest",
              "revision"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "anyOf": [
        {"required": ["shared_case"]},
        {
          "properties": {
            "memories": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "skills": {
              "minItems": 1
            }
          }
        }
      ]
    }
  },
  "title": "Ergora budgeted native preparation DAG task",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preparation_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance",
        "coordinator"
      ],
      "properties": {
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "coordinator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}
