{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "issue_id",
    "input",
    "composition",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 5
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "task_type": {
      "enum": [
        "repository-governance",
        "large-change"
      ]
    },
    "issue_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "starting_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "input": {
      "type": "object"
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "manifest_digest",
        "review_instance",
        "mode",
        "execution",
        "review_protocol",
        "preparation"
      ],
      "properties": {
        "review_protocol": {
          "const": "dag-v1"
        },
        "manifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "mode": {
          "enum": [
            "text-only",
            "task-mcp"
          ]
        },
        "backend_overrides": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding",
              "reason"
            ],
            "properties": {
              "binding": {
                "type": "object"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              }
            }
          }
        },
        "diversity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "enum": [
                "prefer-distinct",
                "require-distinct",
                "allow-same"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "instance",
            "assignments",
            "mode"
          ],
          "properties": {
            "protocol": {
              "const": "work-units-v2"
            },
            "instance": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "assignments": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 128,
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "mode": {
              "const": "workspace-task-mcp"
            }
          }
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "inventory",
            "plan",
            "mode",
            "repository_paths"
          ],
          "properties": {
            "protocol": {
              "const": "preparation-v1"
            },
            "inventory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "plan": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "mode": {
              "enum": [
                "text-only",
                "task-mcp"
              ]
            },
            "repository_paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_sha256"
      ],
      "properties": {
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "not": {
            "pattern": "\\s"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "cleanup_seconds",
        "model_invocations"
      ],
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 604800
        },
        "cleanup_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604799
        },
        "model_invocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 258
        }
      }
    }
  },
  "title": "Ergora budgeted complete six-stage task with persistent preparation"
}
