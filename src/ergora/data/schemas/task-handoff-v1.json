{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ergora task evidence handoff v1",
  "$comment": "(?![\\s\\S]) asserts the absolute end in ECMAScript-compatible patterns; Python's $ also accepts a final LF.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "index",
    "index_sha256",
    "blobs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "format": {
      "const": "ergora-task-handoff"
    },
    "index": {
      "$ref": "#/$defs/index"
    },
    "index_sha256": {
      "$ref": "#/$defs/digest"
    },
    "blobs": {
      "type": "object",
      "maxProperties": 4095,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-f0-9]{64}(?![\\s\\S])": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bytes"
          ],
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777216
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,159}(?![\\s\\S])"
    },
    "artifact": {
      "type": "object",
      "required": [
        "name",
        "path",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "status",
        "artifact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "job_id",
        "job_sha256",
        "state",
        "actor",
        "candidate_sha",
        "artifacts"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "job_id": {
          "$ref": "#/$defs/identifier"
        },
        "job_sha256": {
          "$ref": "#/$defs/digest"
        },
        "state": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "CANCELLED"
          ]
        },
        "actor": {
          "type": "object",
          "required": [
            "id",
            "session_id",
            "role",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "session_id": {
              "type": "string",
              "pattern": "\\S"
            },
            "role": {
              "type": "string",
              "pattern": "\\S"
            },
            "kind": {
              "enum": [
                "agent",
                "ci",
                "human"
              ]
            }
          }
        },
        "candidate_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})(?![\\s\\S])"
        },
        "artifacts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "checks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "job": {
      "type": "object",
      "required": [
        "job_id",
        "job_sha256",
        "stage",
        "request_state",
        "receipt_state",
        "receipt_sha256",
        "receipt",
        "history_event_ids",
        "outcome_reference_state"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/identifier"
        },
        "job_sha256": {
          "$ref": "#/$defs/digest"
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "request_state": {
          "const": "matches"
        },
        "receipt_state": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "CANCELLED"
          ]
        },
        "receipt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        },
        "history_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "outcome_reference_state": {
          "enum": [
            "not_recorded",
            "matches",
            "differs"
          ]
        }
      }
    },
    "index": {
      "type": "object",
      "if": {
        "properties": {
          "temporal_status": {"const": "COMPLETED"}
        }
      },
      "then": {
        "properties": {
          "original_outcome": {"type": "object"}
        }
      },
      "else": {
        "properties": {
          "original_outcome": {"type": "null"}
        }
      },
      "required": [
        "schema_version",
        "project",
        "task_id",
        "workflow_id",
        "run_id",
        "read_only",
        "terminal",
        "temporal_status",
        "lease_released_by_operation",
        "execution_success",
        "published_evidence",
        "unresolved_jobs",
        "unexpected_jobs",
        "request_sha256",
        "profile_sha256",
        "history_jobs_sha256",
        "contract",
        "jobs",
        "original_outcome",
        "original_outcome_sha256"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "project": {
          "$ref": "#/$defs/identifier"
        },
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "read_only": {
          "const": true
        },
        "terminal": {
          "const": true
        },
        "temporal_status": {
          "enum": [
            "COMPLETED",
            "FAILED",
            "CANCELED",
            "TERMINATED",
            "TIMED_OUT"
          ]
        },
        "lease_released_by_operation": {
          "const": false
        },
        "execution_success": {
          "type": "null"
        },
        "published_evidence": {
          "const": "verified"
        },
        "unresolved_jobs": {
          "type": "array",
          "maxItems": 0
        },
        "unexpected_jobs": {
          "type": "array",
          "maxItems": 0
        },
        "request_sha256": {
          "$ref": "#/$defs/digest"
        },
        "profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "history_jobs_sha256": {
          "$ref": "#/$defs/digest"
        },
        "contract": {
          "type": "object",
          "required": [
            "spec",
            "spec_sha256",
            "creation_sha256",
            "submission_sha256",
            "agent_bindings",
            "agent_bindings_sha256"
          ],
          "properties": {
            "spec": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "request",
                "profile",
                "request_sha256",
                "profile_sha256"
              ],
              "properties": {
                "request": {
                  "type": "object",
                  "required": [
                    "task_id"
                  ],
                  "properties": {
                    "task_id": {
                      "$ref": "#/$defs/identifier"
                    }
                  }
                },
                "profile": {
                  "type": "object"
                },
                "request_sha256": {
                  "$ref": "#/$defs/digest"
                },
                "profile_sha256": {
                  "$ref": "#/$defs/digest"
                }
              }
            },
            "spec_sha256": {
              "$ref": "#/$defs/digest"
            },
            "creation_sha256": {
              "$ref": "#/$defs/digest"
            },
            "submission_sha256": {
              "$ref": "#/$defs/digest"
            },
            "agent_bindings": {
              "type": "object"
            },
            "agent_bindings_sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "jobs": {
          "type": "array",
          "maxItems": 4095,
          "items": {
            "$ref": "#/$defs/job"
          }
        },
        "original_outcome": {
          "type": [
            "object",
            "null"
          ]
        },
        "original_outcome_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
