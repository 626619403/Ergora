{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native external review observation linked to the original local source packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "repository", "observation", "packet_sha256", "coverage"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"const": "external-source-review"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_id", "project", "observed_at", "http_status", "response_sha256"],
      "properties": {
        "native_id": {"type": "integer", "minimum": 1},
        "node_id": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "minLength": 1},
        "http_status": {"type": "integer", "const": 200},
        "response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "observation": {"type": "object"},
    "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "coverage": {"const": {
      "platform": "repository-and-single-review-observation",
      "source": "local-exact-Git-objects",
      "comments_and_ci": "not-collected",
      "checks": "operator-supplied-unverified",
      "execution_authorized": false,
      "platform_approval": false
    }}
  }
}
