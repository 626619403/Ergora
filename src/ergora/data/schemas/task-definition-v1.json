{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_type", "issue_id", "input"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "task_type": {"enum": ["repository-governance", "large-change"]},
    "issue_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "starting_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "input": {"type": "object"}
  }
}
