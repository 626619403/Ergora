{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound memory retrospective proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_sha256",
    "baseline_digest",
    "observations",
    "negative_results",
    "cost_and_uncertainty",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_sha256": {
      "$ref": "#/$defs/digest"
    },
    "baseline_digest": {
      "$ref": "#/$defs/digest"
    },
    "observations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "citations",
          "uncertainty"
        ],
        "properties": {
          "claim": {
            "$ref": "#/$defs/text"
          },
          "uncertainty": {
            "$ref": "#/$defs/text"
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "job_id",
                "name",
                "sha256"
              ],
              "properties": {
                "job_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "sha256": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          }
        }
      }
    },
    "negative_results": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "cost_and_uncertainty": {
      "$ref": "#/$defs/text"
    },
    "candidate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "hypothesis",
            "applicability",
            "evaluation_plan"
          ],
          "properties": {
            "text": {
              "$ref": "#/$defs/memory_text"
            },
            "hypothesis": {
              "$ref": "#/$defs/text"
            },
            "applicability": {
              "$ref": "#/$defs/text"
            },
            "evaluation_plan": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "\\S"
    },
    "memory_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "pattern": "\\S"
    }
  }
}
