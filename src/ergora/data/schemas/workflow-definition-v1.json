{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ergora static WorkflowDefinition bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "description",
    "resources",
    "permissions",
    "limits",
    "inputs",
    "outputs",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "resources": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "$ref": "#/$defs/skill"
          }
        ]
      }
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "outputs": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      },
      "minProperties": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "instructions",
            "context"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "skill"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input"
          ],
          "properties": {
            "input": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node",
            "output"
          ],
          "properties": {
            "node": {
              "$ref": "#/$defs/id"
            },
            "output": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write",
        "shell",
        "network"
      ],
      "properties": {
        "read": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "write": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "shell": {
          "type": "boolean"
        },
        "network": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depth",
        "instances",
        "concurrency",
        "material_bytes"
      ],
      "properties": {
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "instances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "material_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "workflow"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/properties/version"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "depends_on",
            "ref",
            "inputs",
            "role",
            "permissions"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "depends_on": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "ref": {
              "allOf": [
                {
                  "$ref": "#/$defs/reference"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "agent"
                    }
                  }
                }
              ]
            },
            "inputs": {
              "$ref": "#/$defs/bindings"
            },
            "role": {
              "$ref": "#/$defs/id"
            },
            "permissions": {
              "$ref": "#/$defs/permissions"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "depends_on",
            "ref",
            "inputs"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "depends_on": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "ref": {
              "allOf": [
                {
                  "$ref": "#/$defs/reference"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "workflow"
                    }
                  }
                }
              ]
            },
            "inputs": {
              "$ref": "#/$defs/bindings"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "depends_on",
            "join"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "depends_on": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 1
            },
            "join": {
              "const": "all"
            }
          }
        }
      ]
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "permissions",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    }
  }
}
