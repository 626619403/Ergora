{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "repo", "templates", "execution", "tracker", "allowed_paths", "checks", "scope_policy"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"},
    "repo": {"type": "string", "minLength": 1},
    "templates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["repository-governance", "large-change", "training-optimization"]}},
    "bindings": {"type": "object", "additionalProperties": {"type": "object"}},
    "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["installation", "config_directory", "state_directory"],
      "properties": {
        "installation": {"type": "string", "minLength": 1},
        "config_directory": {"type": "string", "minLength": 1},
        "state_directory": {"type": "string", "minLength": 1}
      }
    },
    "tracker": {
      "type": "object", "additionalProperties": false, "required": ["kind", "project"],
      "properties": {
        "kind": {"enum": ["local", "github", "gitlab"]},
        "project": {"type": "string", "maxLength": 300, "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$", "not": {"pattern": "\\s"}}
      }
    },
    "allowed_paths": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}},
    "checks": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"}}},
    "scope_policy": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "protected_paths"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "protected_paths": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string"}},
        "max_changed_files": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "max_changed_lines": {"type": "integer", "minimum": 1, "maximum": 10000000}
      }
    }
  }
}
