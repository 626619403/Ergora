{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound Skill retrospective proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_sha256", "baseline_digest", "head_revision", "observations", "negative_results", "cost_and_uncertainty", "candidate"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_sha256": {"$ref": "#/$defs/digest"},
    "baseline_digest": {"$ref": "#/$defs/digest"},
    "head_revision": {"type": "integer", "minimum": 1},
    "observations": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim", "citations", "uncertainty"],
        "properties": {
          "claim": {"$ref": "#/$defs/text"},
          "uncertainty": {"$ref": "#/$defs/text"},
          "citations": {
            "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["job_id", "name", "sha256"],
              "properties": {
                "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
                "name": {"type": "string", "minLength": 1, "maxLength": 128},
                "sha256": {"$ref": "#/$defs/digest"}
              }
            }
          }
        }
      }
    },
    "negative_results": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/text"}},
    "cost_and_uncertainty": {"$ref": "#/$defs/text"},
    "candidate": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["name", "hypothesis", "applicability", "evaluation_plan", "files"],
          "properties": {
            "name": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "hypothesis": {"$ref": "#/$defs/text"},
            "applicability": {"$ref": "#/$defs/text"},
            "evaluation_plan": {"$ref": "#/$defs/text"},
            "files": {
              "type": "object", "minProperties": 1, "maxProperties": 500,
              "required": ["SKILL.md"],
              "additionalProperties": {
                "type": "object", "additionalProperties": false,
                "required": ["text", "executable_bits"],
                "properties": {
                  "text": {"type": "string", "maxLength": 1000000},
                  "executable_bits": {"type": "integer", "enum": [0, 1, 8, 9, 64, 65, 72, 73]}
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S"}
  }
}
