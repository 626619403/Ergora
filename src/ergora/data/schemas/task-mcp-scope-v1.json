{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ergora fixed per-call task MCP resources v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "input_digest", "instance", "tools", "files"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"const": "task-mcp-scope"},
    "run_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "input_digest": {"$ref": "#/$defs/digest"},
    "instance": {"type": "string", "maxLength": 1100, "pattern": "^root(?:/[a-z0-9]+(?:-[a-z0-9]+)*)+$"},
    "tools": {"const": ["list", "read"]},
    "files": {
      "type": "object", "maxProperties": 500,
      "propertyNames": {"type": "string", "maxLength": 1100},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["sha256", "size", "content_base64", "sources"],
        "properties": {
          "sha256": {"$ref": "#/$defs/digest"},
          "size": {"type": "integer", "minimum": 0, "maximum": 10000000},
          "content_base64": {"type": "string", "maxLength": 13333336},
          "sources": {
            "type": "array", "minItems": 1, "maxItems": 1024,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["instance", "definition", "resource_id", "path", "uri"],
              "properties": {
                "instance": {"type": "string", "maxLength": 1100},
                "definition": {
                  "type": "object", "additionalProperties": false,
                  "required": ["kind", "id", "version", "digest"],
                  "properties": {
                    "kind": {"enum": ["agent", "workflow"]},
                    "id": {"type": "string", "maxLength": 64},
                    "version": {"type": "string", "maxLength": 64},
                    "digest": {"$ref": "#/$defs/digest"}
                  }
                },
                "resource_id": {"type": "string", "maxLength": 64},
                "path": {"type": "string", "maxLength": 512},
                "uri": {"type": "string", "maxLength": 1100}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
