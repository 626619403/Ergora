{
  "schema_version": 1,
  "provider": "gitlab",
  "project": "YOUR_GROUP/YOUR_REPO",
  "api_url": "https://gitlab.com/api/v4",
  "token_env": "GITLAB_PAT",
  "repo_url": "git@gitlab.com:YOUR_GROUP/YOUR_REPO.git",
  "workspace_root": "/srv/agent-workspaces",
  "outbox": "/srv/agent-outbox",
  "receipts": "/srv/agent-receipts",
  "approvals": "/srv/bridge-private/admissions",
  "state_dir": "/srv/bridge-state",
  "shared_ingress_db": "/srv/agent-control/ingress/leases.sqlite3",
  "ready_label": "agent-ready",
  "max_concurrent_agents": 3,
  "codex_bin": "/usr/local/bin/codex",
  "symphony_bin": "/opt/symphony/symphony",
  "dashboard_port": 4000,
  "enabled_task_types": [
    "repository-governance",
    "large-change"
  ],
  "repository_state_file": "/srv/project-policy/repository-state.json"
}
