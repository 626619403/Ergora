{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:portable:task:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "task_type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "task_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repository": {
      "type": "object",
      "properties": {
        "base_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "starting_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        }
      },
      "required": [
        "base_sha",
        "starting_sha"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Canonical relative POSIX prefix, no wildcard/control characters, . or .. components, or reserved control metadata. Additional checks enforced by validate_task/validate_spec."
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "risk": {
          "enum": [
            "standard",
            "high"
          ]
        },
        "work_units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                },
                "minItems": 0,
                "maxItems": 23,
                "uniqueItems": true
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "description": "Canonical relative POSIX prefix, no wildcard/control characters, . or .. components, or reserved control metadata. Additional checks enforced by validate_task/validate_spec."
                },
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "required": [
              "id",
              "depends_on",
              "paths",
              "instructions"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true
        }
      },
      "required": [
        "goal",
        "allowed_paths",
        "acceptance",
        "constraints",
        "risk",
        "work_units"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "task_version",
    "project_id",
    "package_sha256",
    "repository",
    "input"
  ],
  "additionalProperties": false,
  "x-semantic-validation": [
    "dev_platform.portable validators enforce digests, canonical paths, policy authority boundaries, capability and workflow support, DAG ownership, legacy profile equivalence and payload bounds. A JSON Schema pass alone is insufficient."
  ]
}
