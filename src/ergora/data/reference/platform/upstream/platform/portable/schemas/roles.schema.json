          "human"
        ],
        "forbidden_actions": [
          "approve-own-plan",
          "merge",
          "deploy",
          "change-trusted-policy"
        ],
        "independent_from": []
      },
      "planner": {
        "capabilities": [
          "repository-read",
          "plan-write"
        ],
        "actor_kinds": [
          "agent",
          "human"
        ],
        "forbidden_actions": [
          "approve-own-plan",
          "merge",
          "deploy",
          "change-trusted-policy"
        ],
        "independent_from": []
      },
      "implementer": {
        "capabilities": [
          "scoped-code-write",
          "test-execution"
        ],
        "actor_kinds": [
          "agent",
          "human"
        ],
        "forbidden_actions": [
          "approve-own-plan",
          "merge",
          "deploy",
          "change-trusted-policy"
        ],
        "independent_from": []
      },
      "integrator": {
        "capabilities": [
          "candidate-integration"
        ],
        "actor_kinds": [
          "agent",
          "human"
        ],
        "forbidden_actions": [
          "approve-own-plan",
