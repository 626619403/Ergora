{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:portable:roles:v1",
  "const": {
    "schema_version": 1,
    "roles": {
      "inspector": {
        "capabilities": [
          "repository-read",
          "baseline-inspection"
        ],
        "actor_kinds": [
