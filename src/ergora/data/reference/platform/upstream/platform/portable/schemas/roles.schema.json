          "change-trusted-policy"
        ],
        "independent_from": [
          "authors"
        ]
      },
      "reviewer": {
        "capabilities": [
          "independent-candidate-review"
        ],
        "actor_kinds": [
          "agent",
          "human"
        ],
        "forbidden_actions": [
          "approve-own-plan",
          "merge",
          "deploy",
          "change-trusted-policy"
        ],
        "independent_from": [
          "authors"
        ]
      }
